NEXT_PUBLIC_SUPABASE_URL=
# Key mới: publishable key (sb_publishable_...), an toàn cho browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Key cũ, deprecated: chỉ dùng tạm trong giai đoạn chuyển đổi.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_...). Không dùng tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Key cũ, deprecated: chỉ dùng tạm trong giai đoạn chuyển đổi.
# SUPABASE_SERVICE_ROLE_KEY=
# URL công khai của web app, dùng để tạo link QR. Ví dụ: https://rms.example.com
NEXT_PUBLIC_SITE_URL=
